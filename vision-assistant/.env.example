# 选择模型：qwen | doubao | gemini | openai（不填则按可用 Key 自动选择）
# 自动优先级：通义千问 > 豆包 > Gemini > OpenAI
AI_PROVIDER=

# —— 通义千问 / DashScope（推荐国内）——
# 控制台：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
# 国内默认；国际站可改为 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 视觉模型推荐：qwen-vl-plus / qwen-vl-max / qwen3-vl-plus
QWEN_MODEL=qwen-vl-plus

# —— 豆包 / 火山方舟 Ark ——
# 控制台：https://console.volcengine.com/ark
ARK_API_KEY=
# 必填：方舟推理接入点 ID，例如 ep-xxxxxxxx
DOUBAO_MODEL=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# —— Gemini（现有）——
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# —— OpenAI ——
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# 高德「Web服务」Key（不是 JS API Key）
AMAP_WEB_KEY=
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=

# FORCE_MOCK=1
