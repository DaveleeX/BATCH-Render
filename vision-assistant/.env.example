# 至少配置一组 AI Key（推荐 Gemini）
GOOGLE_GENERATIVE_AI_API_KEY=
# 可选：指定模型（默认 gemini-3.1-flash-lite）
# GEMINI_MODEL=gemini-3.1-flash-lite

# 或 OpenAI
OPENAI_API_KEY=

# 高德「Web服务」Key（不是 JS API Key）。控制台需勾选 Web服务平台。
# 若报 USERKEY_PLAT_NOMATCH，说明 Key 平台类型不对。
AMAP_WEB_KEY=

# 可选：高德 JS Key（前端地图展示，非必须）
NEXT_PUBLIC_AMAP_JS_KEY=

# 演示模式：即使有 Key 也可强制 mock=1
# FORCE_MOCK=1
