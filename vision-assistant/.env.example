# 选择模型：qwen | doubao | gemini | openai（不填则按可用 Key 自动选择）
# 自动优先级：豆包 > 通义千问 > Gemini > OpenAI
AI_PROVIDER=doubao

# —— 豆包 / 火山方舟 Ark（推荐国内）——
# 控制台：https://console.volcengine.com/ark
# 使用 Responses API：/api/v3/responses
ARK_API_KEY=
# 已开通视觉模型名，或接入点 ep-xxxx
DOUBAO_MODEL=doubao-seed-2-0-lite-260428
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# —— 通义千问 / DashScope ——
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-vl-plus

# —— Gemini / OpenAI（海外备用）——
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# 高德「Web服务」Key（不是 JS API Key）
AMAP_WEB_KEY=
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=
